FROM node:22-alpine
WORKDIR /app
RUN apk add --no-cache openssl poppler-utils openjdk17-jre-headless
COPY package.json package-lock.json ./
RUN npm ci --include=dev --no-audit --no-fund
COPY prisma ./prisma
RUN ./node_modules/.bin/prisma generate
COPY lib ./lib
COPY agents ./agents
COPY scripts/export-worker.cjs ./scripts/export-worker.cjs
ENV NODE_ENV=production
ARG REVISION=unknown
LABEL org.opencontainers.image.revision=$REVISION
USER node
CMD ["node","scripts/export-worker.cjs"]

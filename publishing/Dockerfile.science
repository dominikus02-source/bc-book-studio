# Isolated scientific asset *builder*, not Quarto renderer or application image.
# Build with network access; run read-only, without network, secrets or privileges.
FROM python:3.12-slim
ENV DEBIAN_FRONTEND=noninteractive PYTHONDONTWRITEBYTECODE=1 MPLBACKEND=Agg
RUN apt-get update && apt-get install -y --no-install-recommends \
    fonts-noto-core fonts-dejavu-core fonts-stix \
    libglib2.0-0 libgl1 libcairo2 libpango-1.0-0 libgdk-pixbuf-2.0-0 \
    && rm -rf /var/lib/apt/lists/*
WORKDIR /opt/bc
COPY publishing/requirements-core.txt /opt/bc/publishing/requirements-core.txt
RUN pip install --no-cache-dir --disable-pip-version-check -r publishing/requirements-core.txt
COPY publishing /opt/bc/publishing
RUN useradd --system --uid 10002 --home-dir /nonexistent scientific
USER 10002:10002
ENV PYTHONPATH=/opt/bc HOME=/tmp XDG_CACHE_HOME=/tmp/.cache
WORKDIR /work
ENTRYPOINT ["python", "-m", "publishing.scientific_assets"]

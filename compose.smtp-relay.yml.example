# Host-local Compose override for the IPv6 SMTP forwarder.
# Copy to compose.smtp-relay.yml on the VPS and set the IPv4 gateway of
# the bc-book-studio-runtime_default network.
#
# Nodemailer 10 resolves SMTP hosts with dns.resolve4/6 (it ignores
# extra_hosts). Point `dns` at bc-smtp-dns.service, which must listen
# only on the gateway and answer smtp.gmail.com as that gateway IPv4.
# bc-smtp-v6-relay.service must listen on <gateway>:587 and forward to
# smtp.gmail.com:587 over IPv6 so TLS still verifies as smtp.gmail.com.
# deploy-release.sh and migrate-release.sh include this file when present.
services:
  web:
    extra_hosts:
      - "smtp.gmail.com:172.29.0.1"
    dns:
      - 172.29.0.1

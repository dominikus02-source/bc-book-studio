# Set a long random secret. Required for all editorial endpoints.
STUDIO_API_KEY=
# Must be different from STUDIO_API_KEY; only reviewer can approve/reject.
STUDIO_REVIEWER_API_KEY=
# Dedicated BC Book Studio PostgreSQL database (never reuse BahasaCerdas DB).
DATABASE_URL=
# Optional OpenAI-compatible text generation API.
AI_API_URL=https://api.openai.com/v1/chat/completions
AI_API_KEY=
AI_MODEL=
# Max estimated generation budget per request, enforced in code.
AI_MAX_OUTPUT_TOKENS=1800

# Reuse the verified Bahasa Cerdas password-recovery SMTP provider (currently Resend).
# Map GOTRUE_SMTP_HOST/PORT/USER/PASS/ADMIN_EMAIL from the authorized server secrets manager.
# Never commit SMTP credentials or copy them into source-controlled files.
SMTP_HOST=smtp.resend.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_APP_PASSWORD= # existing Resend SMTP credential, set privately
SMTP_FROM=
APP_ORIGIN=https://bcbookstudio.bahasacerdas.com

# Set a long random secret. Required for all editorial endpoints.
STUDIO_API_KEY=
# Must be different from STUDIO_API_KEY; only reviewer can approve/reject.
STUDIO_REVIEWER_API_KEY=
# Dedicated BC Book Studio PostgreSQL database (never reuse BahasaCerdas DB).
DATABASE_URL=
# Provider API keys are configured by administrators in Settings and encrypted in PostgreSQL.
# Max estimated generation budget per request, enforced in code.
AI_MAX_OUTPUT_TOKENS=1800
# Daily AI generation caps (failed calls also count). Defaults: 30 per user, 200 global.
AI_USER_DAILY_LIMIT=30
AI_GLOBAL_DAILY_LIMIT=200

# Enable only with a verified-email Access policy. JWT validation remains mandatory.
CF_ACCESS_PUBLIC_SIGNUP=false

# Server-only AES-256-GCM master key: base64 of 32 cryptographically random bytes.
# Keep it outside the database and retain a private backup for restoring encrypted keys.
STUDIO_SECRET_ENCRYPTION_KEY=
# Comma-separated verified admin emails; if unset, the legacy editor list manages providers.
CF_ACCESS_ADMIN_EMAILS=
# Public site origin used for browser CSRF checks. Should match APP_ORIGIN.
STUDIO_PUBLIC_ORIGIN=https://bcbookstudio.bahasacerdas.com
APP_ORIGIN=https://bcbookstudio.bahasacerdas.com

# Public origin used for activation/reset links (must be HTTPS in production).
APP_ORIGIN=https://bcbookstudio.bahasacerdas.com
# SMTP for account activation and password-reset email.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_APP_PASSWORD=
SMTP_FROM=
# Optional display name for the From header (default: BC Book Studio).
# SMTP_FROM_NAME=BC Book Studio
# Optional Reply-To. Leave unset for no-reply transactional mail.
# SMTP_REPLY_TO=
# Optional: TLS certificate hostname when SMTP_HOST is a private relay address.
# SMTP_TLS_SERVERNAME=smtp.gmail.com

# Publishing renderer service: use a private URL, never a public hostname.
QUARTO_WORKER_URL=
QUARTO_WORKER_TOKEN=
# On the isolated renderer only:
QUARTO_BIN=
QUARTO_WORKER_BIND=127.0.0.1
QUARTO_WORKER_PORT=39319
QUARTO_WORKER_ALLOW_PRIVATE_BIND=0
# Start a supervised export:worker before setting this to true in production.
EXPORT_WORKER_ENABLED=false
EXPORT_ARTIFACT_DIR=
EXPORT_RETENTION_DAYS=7
# Optional independent validation tools (missing means NOT_RUN):
JAVA_BIN=java
EPUBCHECK_JAR=
PDFFONTS_BIN=pdffonts
VERAPDF_BIN=
VERAPDF_FLAVOUR=ua1

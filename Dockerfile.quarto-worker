FROM node:22-bookworm-slim
WORKDIR /app
RUN apt-get update && apt-get install -y --no-install-recommends ca-certificates curl fontconfig fonts-dejavu-core fonts-liberation \
 && curl -fSL https://github.com/quarto-dev/quarto-cli/releases/download/v1.9.36/quarto-1.9.36-linux-amd64.deb -o /tmp/quarto.deb \
 && echo '8c47762e78fe58642246a94d18f67eb332c1778b711e5bef991ef3c15490d83a  /tmp/quarto.deb' | sha256sum -c - \
 && apt-get install -y --no-install-recommends /tmp/quarto.deb \
 && rm -rf /tmp/quarto.deb /var/lib/apt/lists/*
COPY package.json package-lock.json ./
RUN npm ci --include=dev --no-audit --no-fund
COPY lib ./lib
COPY scripts/quarto-worker-server.cjs ./scripts/quarto-worker-server.cjs
ENV NODE_ENV=production QUARTO_BIN=/usr/local/bin/quarto
RUN command -v quarto && quarto --version
USER node
CMD ["node","scripts/quarto-worker-server.cjs"]

generator client {
  provider = "prisma-client-js"
}
datasource db {
  provider = "postgresql"
  url = env("DATABASE_URL")
}
model Book {
  id String @id @default(cuid())
  ownerId String
  title String
  grade String
  subject String
  description String @default("")
  targetAudience String @default("")
  writingGoal String @default("")
  archivedAt DateTime?
  status BookStatus @default(DRAFT)
  chapters Chapter[]
  reviews Review[]
  briefRevisions BookBriefRevision[]
  approvalSnapshots BookApprovalSnapshot[]
  publishingEvidence BookPublishingEvidence[]
  exportJobs ExportJob[]
  pagination BookPagination?
  paginationRevisions BookPaginationRevision[]
  isbnApplications IsbnApplication[]
  assignedReviewers BookReviewer[]
  assets BookAsset[]
  bookType String @default("NONFICTION")
  genre String @default("REFERENCE")
  pageSize String @default("A4")
  author String @default("BC Book Studio")
  editorialStage String @default("BRIEF")
  editorialChecks Json @default("{}")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  approvedAt DateTime?
  publication BookPublication?
  reviewNotes ReviewerNote[]
  @@index([ownerId, updatedAt])
  @@index([ownerId, archivedAt])
}
model BookBriefRevision {
  id String @id @default(cuid())
  bookId String
  book Book @relation(fields:[bookId],references:[id],onDelete:Cascade)
  actorId String
  snapshot Json
  createdAt DateTime @default(now())
  @@index([bookId,createdAt])
}

model Chapter {
  id String @id @default(cuid())
  bookId String
  book Book @relation(fields: [bookId], references: [id], onDelete: Cascade)
  position Int
  title String
  content String @db.Text
  outlineObjective String @default("")
  archivedAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  revisions ChapterRevision[]
  outlineSections OutlineSection[]
  @@unique([bookId, position])
}
model ChapterRevision {
  id String @id @default(cuid())
  chapterId String
  chapter Chapter @relation(fields: [chapterId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  title String
  content String @db.Text
  outlineObjective String @default("")
  revision Int
  createdAt DateTime @default(now())
  @@unique([chapterId, revision])
}
model BookAsset {
  id String @id @default(cuid())
  bookId String
  book Book @relation(fields: [bookId], references: [id], onDelete: Cascade)
  name String
  mime String
  bytes Bytes @db.ByteA
  size Int
  width Int
  height Int
  altText String
  license String
  sourceUrl String?
  archivedAt DateTime?
  updatedAt DateTime @default(now()) @updatedAt
  revisions BookAssetRevision[]
  createdAt DateTime @default(now())
  @@index([bookId, createdAt])
}

model BookReviewer {
  id String @id @default(cuid())
  bookId String
  reviewerId String
  assignedById String
  assignedAt DateTime @default(now())
  book Book @relation(fields: [bookId], references: [id], onDelete: Cascade)
  reviewer StudioUser @relation(fields: [reviewerId], references: [id], onDelete: Cascade)
  @@unique([bookId, reviewerId])
  @@index([reviewerId, assignedAt])
}

model Review {
  id String @id @default(cuid())
  bookId String
  book Book @relation(fields: [bookId], references: [id], onDelete: Cascade)
  decision String
  note String @default("") @db.Text
  createdAt DateTime @default(now())
}
enum BookStatus {
  DRAFT
  REVIEW
  APPROVED
}

model UsageCounter {
  scope String
  subject String
  period String
  count Int @default(0)
  @@id([scope, subject, period])
}

model ProviderCredential {
  id String @id
  provider String
  label String
  model String
  encryptedKey String @db.Text
  lastFour String
  active Boolean @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([provider])
}
model AiUsageEvent {
  id String @id @default(cuid())
  credentialId String
  provider String
  model String
  purpose String
  actorId String?
  inputTokens Int?
  outputTokens Int?
  totalTokens Int?
  reported Boolean @default(false)
  createdAt DateTime @default(now())
  @@index([credentialId,createdAt])
  @@index([createdAt])
  @@index([actorId,createdAt])
}
model CredentialAudit {
  id String @id @default(cuid())
  actorId String
  credentialId String
  action String
  createdAt DateTime @default(now())
}

enum StudioRole {
  EDITOR
  REVIEWER
  ADMIN
}
model StudioUser {
  id String @id @default(cuid())
  email String @unique
  name String
  role StudioRole @default(EDITOR)
  passwordHash String?
  active Boolean @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  sessions StudioSession[]
  tokens StudioAuthToken[]
  assignedBooks BookReviewer[]
  formDrafts StudioFormDraft[]
  exportJobs ExportJob[]
  isbnEvents IsbnEvent[]
  isbnDocuments IsbnDocument[]
  publisherDocuments PublisherDocument[]
}
model StudioSession {
  id String @id @default(cuid())
  userId String
  user StudioUser @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String @unique
  expiresAt DateTime
  createdAt DateTime @default(now())
  @@index([userId, expiresAt])
}
model StudioAuthToken {
  id String @id @default(cuid())
  userId String
  user StudioUser @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String @unique
  purpose String
  expiresAt DateTime
  usedAt DateTime?
  createdAt DateTime @default(now())
  @@index([userId, purpose, createdAt])
}

model StudioFormDraft {
  id String @id @default(cuid())
  ownerId String
  owner StudioUser @relation(fields:[ownerId],references:[id],onDelete:Cascade)
  module String
  title String
  payload Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([ownerId,module,updatedAt])
}
model BookPublication {
  id String @id @default(cuid())
  bookId String @unique
  book Book @relation(fields:[bookId],references:[id],onDelete:Cascade)
  publishedById String
  publishedAt DateTime @default(now())
  unpublishedAt DateTime?
  version Int @default(1)
  snapshot Json
  @@index([unpublishedAt,publishedAt])
}
model ReviewerNote {
 id String @id @default(cuid())
 bookId String
 book Book @relation(fields:[bookId],references:[id],onDelete:Cascade)
 reviewerId String
 chapterId String?
 category String @default("CONTENT")
 severity String @default("SUGGESTION")
 status String @default("OPEN")
 content String @db.Text
 createdAt DateTime @default(now())
 updatedAt DateTime @updatedAt
 @@index([bookId,reviewerId,createdAt])
}

model BookPagination {
  archivedAt DateTime?
  bookId String @id
  settings Json
  version Int @default(1)
  updatedAt DateTime @updatedAt
  book Book @relation(fields:[bookId],references:[id],onDelete:Cascade)
}

model BookLayout {
  bookId String
  approvedAt DateTime
  version Int @default(1)
  settings Json
  archivedAt DateTime?
  updatedAt DateTime @updatedAt
  approval BookApprovalSnapshot @relation(fields:[bookId,approvedAt],references:[bookId,approvedAt],onDelete:Restrict)

  @@id([bookId,approvedAt])
}

model BookApprovalSnapshot {
  bookId String
  approvedAt DateTime
  reviewerId String
  manuscript Json
  layout BookLayout?
  layoutRevisions BookLayoutRevision[]
  book Book @relation(fields: [bookId], references: [id], onDelete: Restrict)

  @@id([bookId, approvedAt])
}


model OutlineSection {
  id String @id @default(cuid())
  bookId String
  chapterId String
  chapter Chapter @relation(fields:[chapterId],references:[id],onDelete:Cascade)
  parentId String?
  parent OutlineSection? @relation("OutlineHierarchy",fields:[parentId],references:[id],onDelete:Cascade)
  children OutlineSection[] @relation("OutlineHierarchy")
  position Int
  title String
  objective String
  content String @default("") @db.Text
  genreTarget String @default("NONFICTION")
  accessTier String @default("DRAFT")
  archivedAt DateTime?
  updatedAt DateTime @default(now()) @updatedAt
  createdAt DateTime @default(now())
  revisions OutlineSectionRevision[]
  @@index([chapterId,parentId,archivedAt,position])
  @@index([bookId,archivedAt])
}
model OutlineSectionRevision {
  id String @id @default(cuid())
  sectionId String
  section OutlineSection @relation(fields:[sectionId],references:[id],onDelete:Cascade)
  actorId String
  action String
  snapshot Json
  createdAt DateTime @default(now())
  @@index([sectionId,createdAt])
}


model BookAssetRevision {
  id String @id @default(cuid())
  assetId String
  asset BookAsset @relation(fields:[assetId],references:[id],onDelete:Cascade)
  actorId String
  action String
  metadata Json
  createdAt DateTime @default(now())
  @@index([assetId,createdAt])
}


/// Append-only submission and independent review trail for publishing evidence.
/// An older approval or layout version remains in history but is never current proof.
model BookPublishingEvidence {
  id String @id @default(cuid())
  bookId String
  book Book @relation(fields:[bookId],references:[id],onDelete:Restrict)
  actorId String
  kind String
  status String
  approvedAt DateTime
  layoutVersion Int
  referenceUrl String?
  isbn String?
  checksum String?
  validator String?
  validatorVersion String?
  artifactBytes Int?
  note String @db.Text
  reviewedSubmissionId String?
  createdAt DateTime @default(now())
  @@index([bookId,kind,approvedAt,layoutVersion,createdAt], map: "BookPublishingEvidence_bookId_kind_approvedAt_layoutVersion_cre")
  @@index([bookId,createdAt])
}

model ExportJob {
 id String @id @default(cuid())
 bookId String
 book Book @relation(fields:[bookId],references:[id],onDelete:Cascade)
 ownerId String
 owner StudioUser @relation(fields:[ownerId],references:[id],onDelete:Cascade)
 status String @default("QUEUED")
 preview Boolean @default(true)
 sizes Json
 sourceApprovedAt DateTime?
 sourceLayoutVersion Int?
 sourcePaginationVersion Int?
 sourceSnapshotHash String?
 progress Int @default(0)
 currentStep String @default("Queued")
 cancellationRequested Boolean @default(false)
 leaseUntil DateTime?
 attempts Int @default(0)
 error String?
 resultBytes Int?
 resultSha256 String?
 startedAt DateTime?
 finishedAt DateTime?
 createdAt DateTime @default(now())
 updatedAt DateTime @updatedAt
 @@index([ownerId,createdAt])
 @@index([status,leaseUntil])
}


model PublisherProfile {
 id String @id @default("bci-publisher")
 legalName String @default("PT Bahasa Cerdas Indonesia")
 imprintName String @default("Bahasa Cerdas Indonesia")
 directorName String @default("")
 legalAddress String @default("") @db.Text
 correspondenceAddress String @default("") @db.Text
 email String @default("")
 phone String @default("")
 officialWebsite String @default("")
 catalogWebsite String @default("")
 nib String @default("")
 kbli String @default("")
 decreeNumber String @default("")
 deedNumber String @default("")
 perpusnasAccountStatus String @default("NOT_REGISTERED")
 perpusnasReference String @default("")
 approvalNote String @default("") @db.Text
 updatedById String?
 createdAt DateTime @default(now())
 updatedAt DateTime @updatedAt
 applications IsbnApplication[]
 documents PublisherDocument[]
}

model IsbnApplication {
 id String @id @default(cuid())
 publisherId String @default("bci-publisher")
 publisher PublisherProfile @relation(fields:[publisherId],references:[id],onDelete:Restrict)
 bookId String
 book Book @relation(fields:[bookId],references:[id],onDelete:Restrict)
 createdById String
 title String
 subtitle String @default("")
 authorNames String @default("")
 language String @default("id")
 editionNumber Int @default(1)
 format String @default("PRINT")
 binding String @default("PAPERBACK")
 paperSize String @default("a5")
 imprint String @default("Bahasa Cerdas Indonesia")
 plannedPublicationYear Int?
 catalogUrl String @default("")
 territory String @default("GLOBAL")
 rightsBasis String @default("ORIGINAL")
 originalWorkReference String @default("")
 externalReference String @default("")
 officialEvidenceUrl String @default("")
 isbn13 String? @unique
 kdtReference String @default("")
 barcodeReference String @default("")
 status String @default("DRAFT")
 submittedAt DateTime?
 issuedAt DateTime?
 publishedAt DateTime?
 note String @default("") @db.Text
 archivedAt DateTime?
 createdAt DateTime @default(now())
 updatedAt DateTime @updatedAt
 events IsbnEvent[]
 documents IsbnDocument[]
 @@index([bookId,createdAt])
 @@index([status,updatedAt])
}

model IsbnDocument {
 id String @id @default(cuid())
 applicationId String
 application IsbnApplication @relation(fields:[applicationId],references:[id],onDelete:Cascade)
 uploaderId String
 uploader StudioUser @relation(fields:[uploaderId],references:[id],onDelete:Restrict)
 kind String
 filename String
 mime String
 bytes Bytes @db.ByteA
 size Int
 sha256 String
 createdAt DateTime @default(now())
 @@index([applicationId,kind,createdAt])
}

model IsbnEvent {
 id String @id @default(cuid())
 applicationId String
 application IsbnApplication @relation(fields:[applicationId],references:[id],onDelete:Cascade)
 actorId String
 actor StudioUser @relation(fields:[actorId],references:[id],onDelete:Restrict)
 action String
 detail Json
 createdAt DateTime @default(now())
 @@index([applicationId,createdAt])
}

model PublisherDocument {
 id String @id @default(cuid())
 publisherId String
 publisher PublisherProfile @relation(fields:[publisherId],references:[id],onDelete:Restrict)
 uploaderId String
 uploader StudioUser @relation(fields:[uploaderId],references:[id],onDelete:Restrict)
 kind String
 filename String
 mime String
 bytes Bytes @db.ByteA
 size Int
 sha256 String
 archivedAt DateTime?
 createdAt DateTime @default(now())
 @@index([publisherId,kind,createdAt])
}

model BookLayoutRevision {
 id String @id @default(cuid())
 bookId String
 approvedAt DateTime
 version Int
 settings Json
 archivedAt DateTime?
 actorId String
 createdAt DateTime @default(now())
 approval BookApprovalSnapshot @relation(fields:[bookId,approvedAt],references:[bookId,approvedAt],onDelete:Restrict,map:"BookLayoutRevision_approval_fkey")
 @@unique([bookId,approvedAt,version])
}
model BookPaginationRevision {
 id String @id @default(cuid())
 bookId String
 version Int
 settings Json
 archivedAt DateTime?
 actorId String
 action String
 createdAt DateTime @default(now())
 book Book @relation(fields:[bookId],references:[id],onDelete:Restrict)
 @@unique([bookId,version])
}

generator client {
  provider = "prisma-client-js"
}
datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}
model Book {
  id          String    @id @default(cuid())
  title       String
  grade       String
  subject     String
  description String    @default("")
  status      BookStatus @default(DRAFT)
  chapters    Chapter[]
  reviews     Review[]
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  approvedAt  DateTime?
}
model Chapter {
  id        String   @id @default(cuid())
  bookId    String
  book      Book     @relation(fields: [bookId], references: [id], onDelete: Cascade)
  position  Int
  title     String
  content   String   @db.Text
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@unique([bookId, position])
}
model Review {
  id        String   @id @default(cuid())
  bookId    String
  book      Book     @relation(fields: [bookId], references: [id], onDelete: Cascade)
  decision  String
  note      String   @default("") @db.Text
  createdAt DateTime @default(now())
}
enum BookStatus {
  DRAFT
  REVIEW
  APPROVED
}

enum StudioRole {
  EDITOR
  REVIEWER
  ADMIN
}
model StudioUser {
  id String @id @default(cuid())
  email String @unique
  name String
  role StudioRole @default(EDITOR)
  passwordHash String?
  active Boolean @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  sessions StudioSession[]
  tokens StudioAuthToken[]
}
model StudioSession {
  id String @id @default(cuid())
  userId String
  user StudioUser @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String @unique
  expiresAt DateTime
  createdAt DateTime @default(now())
  @@index([userId, expiresAt])
}
model StudioAuthToken {
  id String @id @default(cuid())
  userId String
  user StudioUser @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String @unique
  purpose String
  expiresAt DateTime
  usedAt DateTime?
  createdAt DateTime @default(now())
  @@index([userId, purpose, createdAt])
}
